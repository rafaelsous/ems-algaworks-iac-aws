terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

# Configure the AWS Provider
provider "aws" {
  region = "us-east-1"
}

resource "aws_s3_bucket" "algadelivery-test-tofu" {
  bucket = "algadelivery-test-tofu"

  tags = {
    Name        = "algadelivery-test-tofu"
    Environment = "Development"
  }
}

